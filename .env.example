# URL del backend API
PUBLIC_BACKEND_URL=https://vitrinepro-bakend-production.up.railway.app

# URL del frontend (para redirecciones OAuth, etc)
PUBLIC_FRONTEND_URL=http://localhost:4321

# Entorno (development | production)
PUBLIC_ENVIRONMENT=development

# OAuth - Google (https://console.cloud.google.com)
PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# OAuth - LinkedIn (https://www.linkedin.com/developers)
PUBLIC_LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
