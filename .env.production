# Variables de Entorno - Producción (v8pro.com.br)
# ================================================

# URL del backend
PUBLIC_BACKEND_URL=https://vitrinepro-bakend-production.up.railway.app

# URL del frontend (para redirecciones)
PUBLIC_FRONTEND_URL=https://www.v8pro.com.br

# Entorno
PUBLIC_ENVIRONMENT=production

# OAuth - Google
PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# OAuth - LinkedIn
PUBLIC_LINKEDIN_CLIENT_ID=your_linkedin_client_id_here
