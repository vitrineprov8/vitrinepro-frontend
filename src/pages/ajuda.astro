---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const guides = [
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z"/>`,
    title: 'Configurar seu perfil',
    desc: 'Aprenda a personalizar seu perfil público com foto, bio, localização e links de redes sociais.',
    steps: [
      'Acesse o Painel e clique em "Perfil" no menu lateral.',
      'Faça upload da sua foto de perfil (avatar) — recomendamos uma imagem quadrada de pelo menos 400×400px.',
      'Adicione uma imagem de banner (proporção 3:1) para personalizar o topo do seu perfil.',
      'Preencha seus dados: nome, profissão, bio, localização, site e telefone.',
      'Adicione links para suas redes sociais na seção "Redes Sociais".',
      'Clique em "Salvar" para publicar as alterações.',
    ]
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.409a2.25 2.25 0 013.182 0l2.909 2.909M3 21h18M3.75 3h16.5A.75.75 0 0121 3.75v14.25a.75.75 0 01-.75.75H3.75A.75.75 0 013 18V3.75A.75.75 0 013.75 3z"/>`,
    title: 'Criar um projeto',
    desc: 'Passo a passo para publicar seu primeiro projeto com imagens, descrição e detalhes.',
    steps: [
      'Acesse o Painel → "Projetos" → "Novo Projeto".',
      'Preencha o Título (obrigatório) e a Descrição (obrigatória).',
      'Opcionalmente adicione Subtítulo e Conteúdo detalhado com o editor rich-text.',
      'Na barra lateral, adicione uma imagem de capa (proporção 16:9).',
      'Selecione as Tags relevantes para o projeto.',
      'Preencha os detalhes: cliente, ano, duração, seu papel e link externo.',
      'Clique em "Salvar rascunho" para guardar sem publicar, ou "Publicar" para tornar público.',
      'Após salvar, a seção "Galeria de imagens" fica disponível — adicione imagens e organize-as arrastando.',
    ]
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M12 7.5h1.5m-1.5 3h1.5m-7.5 3h7.5m-7.5 3h7.5m3-9h3.375c.621 0 1.125.504 1.125 1.125V18a2.25 2.25 0 0 1-2.25 2.25M16.5 7.5V18a2.25 2.25 0 0 0 2.25 2.25M16.5 7.5V4.875c0-.621-.504-1.125-1.125-1.125H4.125C3.504 3.75 3 4.254 3 4.875V18a2.25 2.25 0 0 0 2.25 2.25h13.5M6 7.5h3v3H6v-3Z"/>`,
    title: 'Publicar um artigo',
    desc: 'Escreva e publique artigos profissionais com o editor de texto rico.',
    steps: [
      'Acesse o Painel → "Artigos" → "Novo Artigo".',
      'Preencha o Título (obrigatório).',
      'Use o editor rich-text para escrever seu conteúdo — suporta títulos, negrito, itálico, links, imagens e mais.',
      'Adicione uma imagem de capa (16:9) pela barra lateral.',
      'Opcionalmente, adicione Subtítulo, Conclusão e Tags.',
      'Clique em "Salvar rascunho" para salvar ou "Publicar" para tornar público.',
      'O sistema salva rascunhos automaticamente a cada 30 segundos.',
    ]
  },
  {
    icon: `<path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m.75 12 3 3m0 0 3-3m-3 3v-6m-1.5-9H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"/>`,
    title: 'Fazer upload de currículo',
    desc: 'Disponibilize seu currículo para download no seu perfil público.',
    steps: [
      'Acesse o Painel → "Currículos".',
      'Clique em "Adicionar Currículo".',
      'Digite um nome para identificar o arquivo (ex: "CV Português 2026").',
      'Selecione o arquivo PDF do seu computador.',
      'Clique em "Salvar". O currículo aparecerá na aba "Sobre" do seu perfil.',
      'Você pode ter múltiplos currículos e marcar os ativos.',
    ]
  },
];
---

<BaseLayout
  title="Central de Ajuda - VitrinePro"
  description="Guias e tutoriais para usar todos os recursos da plataforma VitrinePro."
>
  <Header />

  <main class="static-page">
    <div class="static-page-header">
      <div class="container">
        <p class="static-page-label">Suporte</p>
        <h1>Central de Ajuda</h1>
        <p class="static-page-subtitle">Guias passo a passo para aproveitar ao máximo a VitrinePro.</p>
      </div>
    </div>

    <div class="container">
      <div class="static-page-content help-content">

        <div class="help-guides-grid">
          {guides.map(guide => (
            <div class="help-guide-card">
              <div class="help-guide-icon">
                <svg width="28" height="28" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24" set:html={guide.icon} />
              </div>
              <h2 class="help-guide-title">{guide.title}</h2>
              <p class="help-guide-desc">{guide.desc}</p>
              <ol class="help-steps">
                {guide.steps.map(step => (
                  <li>{step}</li>
                ))}
              </ol>
            </div>
          ))}
        </div>

        <div class="help-more">
          <div class="help-more-inner">
            <h3>Não encontrou o que precisava?</h3>
            <p>Consulte as perguntas frequentes ou entre em contato direto com nossa equipe.</p>
            <div class="faq-cta-actions">
              <a href="/faq" class="btn btn-primary">Ver FAQ</a>
              <a href="/contato" class="btn btn-secondary">Falar com Suporte</a>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  @import '../styles/static-pages.css';
</style>
