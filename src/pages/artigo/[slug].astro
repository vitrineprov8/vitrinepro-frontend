---
export const prerender = false;
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ArticleContent from '../../components/profile/ArticleContent.vue';

const SITE = 'https://v8pro.com.br';
const { slug } = Astro.params;
const BACKEND = import.meta.env.PUBLIC_BACKEND_URL || 'http://localhost:3000';

let article: any = null;
let notFound = false;

try {
  const res = await fetch(`${BACKEND}/articles/${slug}`);
  if (res.status === 404) {
    notFound = true;
  } else if (res.ok) {
    article = await res.json();
  } else {
    notFound = true;
  }
} catch {
  notFound = true;
}

const authorName = article?.user
  ? `${article.user.firstName ?? ''} ${article.user.lastName ?? ''}`.trim()
  : 'VitrinePro';
const authorUsername = article?.user?.username ?? null;

const title = article ? `${article.title} | VitrinePro` : 'Artigo não encontrado | VitrinePro';
const description = article?.subtitle || article?.title || 'Leia este artigo no VitrinePro';
const ogImage = article?.coverImageUrl || `${SITE}/og-default.png`;
const canonicalUrl = `${SITE}/artigo/${slug}`;

// JSON-LD BlogPosting
const articleSchema = article ? {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: article.title,
  description: article.subtitle || article.title,
  image: article.coverImageUrl ? [article.coverImageUrl] : [],
  datePublished: article.publishedAt || article.createdAt,
  dateModified: article.updatedAt || article.createdAt,
  author: {
    '@type': 'Person',
    name: authorName,
    url: authorUsername ? `${SITE}/perfil/${authorUsername}` : SITE,
  },
  publisher: {
    '@type': 'Organization',
    name: 'VitrinePro',
    url: SITE,
    logo: { '@type': 'ImageObject', url: `${SITE}/favicon.svg` },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalUrl },
  url: canonicalUrl,
} : null;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {article && <meta name="author" content={authorName} />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="article" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="VitrinePro" />
    {article?.publishedAt && <meta property="article:published_time" content={article.publishedAt} />}
    {article?.updatedAt && <meta property="article:modified_time" content={article.updatedAt} />}
    {article && <meta property="article:author" content={authorName} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@vitrinev8pro" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD BlogPosting -->
    {articleSchema && <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} />}

    <style is:global>
      @import '../../styles/global.css';
      @import '../../styles/dashboard.css';
    </style>
  </head>
  <body>
    <Header />
    <main>
      {notFound ? (
        <div style="min-height:60vh;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;text-align:center;padding:2rem">
          <h1 style="font-size:1.5rem;color:var(--text-primary)">Artigo não encontrado</h1>
          <p style="color:var(--text-secondary)">Este artigo não existe ou foi removido.</p>
          <a href="/" class="btn btn-primary">Voltar ao início</a>
        </div>
      ) : (
        <ArticleContent client:load article={article} />
      )}
    </main>
    <Footer />
  </body>
</html>
