---
export const prerender = false;
import PublicArticlePage from '../../components/profile/PublicArticlePage.vue';
const { slug } = Astro.params;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Artigo | VitrinePro</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      @import '../../styles/global.css';
      @import '../../styles/dashboard.css';
    </style>
  </head>
  <body>
    <PublicArticlePage client:load slug={slug!} />
  </body>
</html>
