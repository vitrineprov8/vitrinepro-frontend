---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
  title="Contato | VitrinePro"
  description="Entre em contato com a equipe VitrinePro pelo LinkedIn ou Instagram. Respondemos em até 48 horas."
  canonical="https://v8pro.com.br/contato"
>
  <Header />

  <main class="static-page">
    <div class="static-page-header">
      <div class="container">
        <p class="static-page-label">Suporte</p>
        <h1>Entre em Contato</h1>
        <p class="static-page-subtitle">Respondemos em até 48 horas nos dias úteis.</p>
      </div>
    </div>

    <div class="container">
      <div class="contact-layout">

        <!-- Contact channels -->
        <div class="contact-channels">
          <h2 class="contact-channels-title">Como podemos ajudar?</h2>

          <div class="contact-card-grid">
            <a href="https://www.linkedin.com/in/vitrinepro-v8-5015713b0/" target="_blank" rel="noopener" class="contact-channel-card">
              <div class="contact-channel-icon" style="background:#e8f1fc;color:#0a66c2">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z"/>
                </svg>
              </div>
              <div class="contact-channel-info">
                <h3>LinkedIn</h3>
                <p>Conecte-se e envie uma mensagem direta à nossa equipe no LinkedIn.</p>
                <span class="contact-channel-link">Visitar perfil →</span>
              </div>
            </a>

            <a href="https://www.instagram.com/vitrine.v8pro/" target="_blank" rel="noopener" class="contact-channel-card">
              <div class="contact-channel-icon" style="background:#fce8f3;color:#e1306c">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
              <div class="contact-channel-info">
                <h3>Instagram</h3>
                <p>Siga-nos e envie uma mensagem direta pelo Instagram.</p>
                <span class="contact-channel-link">Seguir @vitrine.v8pro →</span>
              </div>
            </a>

            <div class="contact-channel-card contact-channel-static">
              <div class="contact-channel-icon" style="background:#edf5ff;color:var(--primary)">
                <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 1 1-18 0 9 9 0 0 1 18 0Zm-9 5.25h.008v.008H12v-.008Z"/>
                </svg>
              </div>
              <div class="contact-channel-info">
                <h3>FAQ</h3>
                <p>Verifique se sua dúvida já está respondida em nossas perguntas frequentes.</p>
                <a href="/faq" class="contact-channel-link">Ver perguntas frequentes →</a>
              </div>
            </div>
          </div>

          <div class="contact-info-box">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z"/></svg>
            <p><strong>Horário de atendimento:</strong> Segunda a Sexta, das 9h às 18h (Horário de Brasília). Respondemos mensagens do fim de semana na segunda-feira.</p>
          </div>
        </div>

      </div>
    </div>
  </main>

  <Footer />
</BaseLayout>

<style is:global>
  @import '../styles/static-pages.css';
</style>
