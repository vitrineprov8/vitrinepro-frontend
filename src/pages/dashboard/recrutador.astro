---
// Legacy redirect: /dashboard/recrutador?tab=... → new URL-based contexts
// Kept for backwards compatibility with bookmarks and email links.
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="robots" content="noindex,nofollow" />
    <title>Redirecionando...</title>
    <script is:inline>
      (function () {
        try {
          var params = new URLSearchParams(window.location.search);
          var tab = params.get('tab');
          var dest;
          if (tab === 'publicar') {
            dest = '/dashboard/hunter/pessoal';
          } else if (tab === 'servicos') {
            dest = '/dashboard/hunter/pessoal?tab=planos';
          } else if (tab === 'carreira') {
            dest = '/dashboard/profissional';
          } else {
            // No tab or unknown tab — go to profissional by default
            dest = '/dashboard/profissional';
          }
          window.location.replace(dest);
        } catch (e) {
          window.location.replace('/dashboard/profissional');
        }
      })();
    </script>
  </head>
  <body></body>
</html>
