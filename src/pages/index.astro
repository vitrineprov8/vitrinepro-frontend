---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroBrand from '../components/HeroBrand.vue';
import HeroCTA from '../components/HeroCTA.vue';
import BenefitsSection from '../components/BenefitsSection.vue';
import WhyChoose from '../components/WhyChoose.vue';
import HowItWorks from '../components/HowItWorks.vue';
import FeaturedSection from '../components/FeaturedSection.vue';
import ShowcaseSection from '@components/ShowcaseSection.vue';
---

<BaseLayout
  title="VitrinePro - Crie Seu Portfólio Profissional Online"
  description="Crie seu portfólio profissional completo. Ideal para advogados, médicos, programadores e todos os profissionais que querem se destacar. Gratuito e fácil de usar."
  canonical="https://v8pro.com.br"
  ogImage="https://v8pro.com.br/og-default.png"
>
  <Header />

  <main>
    <HeroBrand client:visible />
    <HeroCTA client:visible />
    <BenefitsSection client:visible />
    <HowItWorks client:visible />
    <ShowcaseSection client:visible />

<!--     <FeaturedSection client:visible />
    <HowItWorks client:visible />
    <WhyChoose client:visible /> -->
  </main>

  <Footer />
</BaseLayout>
