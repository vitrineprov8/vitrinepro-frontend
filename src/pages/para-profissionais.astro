---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const SITE = 'https://v8pro.com.br';
const canonicalUrl = `${SITE}/para-profissionais`;

const webPageSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: 'VitrinePro para Profissionais — Crie Sua Vitrine Profissional',
  description: 'Pare de mandar currículo em PDF. Crie sua vitrine, apareça no Google e receba propostas — sem saber nada de tecnologia.',
  url: canonicalUrl,
  inLanguage: 'pt-BR',
};

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Preciso saber programar para criar minha vitrine?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Não. O VitrinePro foi feito para qualquer profissional criar sua vitrine em minutos, sem nenhum conhecimento técnico. Você preenche os campos, sobe suas fotos e está no ar.',
      },
    },
    {
      '@type': 'Question',
      name: 'É realmente gratuito? Vou ter que pagar depois?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sim, é totalmente grátis. Não existe plano pago para profissionais — você tem acesso completo a perfil ilimitado, portfólio, candidatura a vagas, botão WhatsApp e URL personalizada sem pagar nada. Nunca pediremos cartão de crédito.',
      },
    },
    {
      '@type': 'Question',
      name: 'Tem plano pago? Vou ter que pagar depois?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Não. Para profissionais o VitrinePro é e continuará sendo gratuito. Monetizamos pelo lado dos recrutadores e empresas, não pelo lado de quem busca oportunidades. Pode criar sua vitrine sem medo.',
      },
    },
    {
      '@type': 'Question',
      name: 'Minha vitrine vai aparecer no Google?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sim. Cada vitrine é otimizada para SEO desde o primeiro dia — título, meta descrição, structured data e URL amigável. Muitos profissionais relatam aparecer nas primeiras buscas em menos de 30 dias.',
      },
    },
  ],
};
---

<BaseLayout
  title="VitrinePro para Profissionais — Apareça no Google, Receba Propostas"
  description="Pare de mandar currículo em PDF. Crie sua vitrine profissional, apareça no Google e receba propostas — grátis, em 5 minutos, sem precisar saber de tecnologia."
  canonical={canonicalUrl}
  ogImage="https://v8pro.com.br/og-default.png"
  ogType="website"
>
  <slot name="head">
    <script type="application/ld+json" set:html={JSON.stringify(webPageSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </slot>

  <Header />

  <main>

    <!-- ═══════════════════════════════════════════════════
         HERO
    ════════════════════════════════════════════════════ -->
    <section class="lp-hero">
      <div class="lp-container">
        <div class="lp-hero__inner">

          <!-- Texto -->
          <div class="lp-hero__text">
            <div class="lp-hero__badge">
              Novo — para profissionais brasileiros
            </div>
            <h1 class="lp-hero__title">
              Pare de mandar<br/>
              <em>currículo em PDF.</em>
            </h1>
            <p class="lp-hero__subtitle">
              Crie sua vitrine profissional, apareça no Google e receba propostas — sem saber nada de tecnologia. Em 5 minutos você já tem seu endereço online.
            </p>
            <div class="lp-hero__actions">
              <a href="/auth/register" class="lp-btn lp-btn--primary lp-btn--lg"
                 data-cta-location="hero" data-cta-label="Criar minha vitrine grátis">
                Criar minha vitrine grátis
              </a>
              <a href="/explorar" class="lp-btn lp-btn--outline-dark"
                 data-cta-location="hero" data-cta-label="Ver exemplos de vitrines">
                Ver exemplos de vitrines
              </a>
            </div>
            <p class="lp-hero__note">
              <span class="check-green">&#10003;</span> Totalmente grátis &nbsp;|&nbsp; Sem cartão de crédito
            </p>
          </div>

          <!-- Mockup do perfil -->
          <div class="lp-hero__visual">
            <div class="lp-mockup">
              <div class="lp-mockup__bar">
                <span class="lp-mockup__dot lp-mockup__dot--red"></span>
                <span class="lp-mockup__dot lp-mockup__dot--yellow"></span>
                <span class="lp-mockup__dot lp-mockup__dot--green"></span>
                <span class="lp-mockup__url">v8pro.com.br/perfil/ana-silva</span>
              </div>
              <div class="lp-mockup__body">
                <!-- Avatar + nome mock -->
                <div class="mock-profile">
                  <div class="mock-avatar">AS</div>
                  <div class="mock-info">
                    <div class="mock-name">Ana Silva</div>
                    <div class="mock-role">Designer de Produto · São Paulo</div>
                    <div class="mock-tags">
                      <span class="lp-tag">UX/UI</span>
                      <span class="lp-tag">Figma</span>
                      <span class="lp-tag">Branding</span>
                    </div>
                  </div>
                </div>
                <!-- Grid de projetos mock -->
                <div class="mock-projects">
                  <div class="mock-project mock-project--1">
                    <div class="mock-project-overlay">App de Finanças</div>
                  </div>
                  <div class="mock-project mock-project--2">
                    <div class="mock-project-overlay">E-commerce</div>
                  </div>
                  <div class="mock-project mock-project--3">
                    <div class="mock-project-overlay">Dashboard</div>
                  </div>
                </div>
                <!-- Botão WhatsApp mock -->
                <div class="mock-cta-row">
                  <div class="mock-whatsapp-btn">Enviar mensagem no WhatsApp</div>
                </div>
              </div>
            </div>
            <!-- Floating badges -->
            <div class="float-badge float-badge--top">
              <span class="float-badge__dot"></span>
              <span>Perfil encontrado no Google</span>
            </div>
            <div class="float-badge float-badge--bottom">
              <span>+3 propostas esta semana</span>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         PROVA SOCIAL
    ════════════════════════════════════════════════════ -->
    <section class="lp-social-proof">
      <div class="lp-container">
        <div class="lp-social-proof__inner">
          <div class="lp-social-proof__grid">
            <div>
              <div class="lp-social-proof__stat">+2.400</div>
              <div class="lp-social-proof__label">profissionais com vitrine no ar</div>
            </div>
            <div>
              <div class="lp-social-proof__stat">+18k</div>
              <div class="lp-social-proof__label">visualizações mensais de perfis</div>
            </div>
            <div>
              <div class="lp-social-proof__stat">5 min</div>
              <div class="lp-social-proof__label">para criar sua vitrine completa</div>
            </div>
            <div>
              <div class="lp-social-proof__stat">R$0</div>
              <div class="lp-social-proof__label">para começar — grátis de verdade</div>
            </div>
          </div>
        </div>
        <!-- Profissões atendidas -->
        <div class="profissoes-strip">
          <span class="profissao-chip">Designers</span>
          <span class="profissao-chip">Advogados</span>
          <span class="profissao-chip">Fotógrafos</span>
          <span class="profissao-chip">Arquitetos</span>
          <span class="profissao-chip">Contadores</span>
          <span class="profissao-chip">Consultores</span>
          <span class="profissao-chip">Engenheiros</span>
          <span class="profissao-chip">Médicos</span>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         3 DORES RESOLVIDAS
    ════════════════════════════════════════════════════ -->
    <section class="lp-section lp-section--alt">
      <div class="lp-container">
        <h2 class="lp-section-title">Você já se reconheceu em alguma dessas situações?</h2>
        <p class="lp-section-subtitle">Esses são os problemas que todo profissional autônomo enfrenta — e o VitrinePro resolve cada um deles.</p>

        <div class="lp-cards">

          <div class="lp-card lp-card--dor">
            <div class="lp-dor-top">
              <div class="dor-icon dor-icon--red">&#128196;</div>
              <div class="dor-label">Dor #1</div>
            </div>
            <h3 class="lp-card__title">"O currículo não mostra o meu trabalho"</h3>
            <p class="lp-card__body">Você manda um PDF com texto e o cliente não consegue imaginar a qualidade do que você entrega. No VitrinePro, você mostra imagens, cases, resultados reais.</p>
            <div class="dor-solucao">Solucao: Portfólio visual com projetos em destaque</div>
          </div>

          <div class="lp-card lp-card--dor">
            <div class="lp-dor-top">
              <div class="dor-icon dor-icon--orange">&#128247;</div>
              <div class="dor-label">Dor #2</div>
            </div>
            <h3 class="lp-card__title">"Meu Instagram some no feed em 24 horas"</h3>
            <p class="lp-card__body">Você posta um trabalho incrível, ganha uns likes e acabou. Sua vitrine no VitrinePro tem URL fixa, indexada no Google — alguém pode te encontrar daqui a 2 anos.</p>
            <div class="dor-solucao">Solucao: URL permanente com SEO ativo</div>
          </div>

          <div class="lp-card lp-card--dor">
            <div class="lp-dor-top">
              <div class="dor-icon dor-icon--blue">&#128187;</div>
              <div class="dor-label">Dor #3</div>
            </div>
            <h3 class="lp-card__title">"Site custa caro e é difícil de fazer"</h3>
            <p class="lp-card__body">Agência cobra R$3.000+ para fazer um site que você não consegue atualizar sozinho. No VitrinePro você cria, edita e publica em minutos — sem nenhum código.</p>
            <div class="dor-solucao">Solucao: Pronto em 5 minutos, grátis</div>
          </div>

        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         COMO FUNCIONA
    ════════════════════════════════════════════════════ -->
    <section class="lp-section">
      <div class="lp-container">
        <h2 class="lp-section-title">Como funciona</h2>
        <p class="lp-section-subtitle">Três passos para sua vitrine estar no ar e aparecendo no Google.</p>

        <div class="lp-steps">
          <div class="lp-step">
            <div class="lp-step__num">1</div>
            <div class="lp-step__content">
              <h3>Crie sua conta grátis</h3>
              <p>Cadastro em 30 segundos com e-mail ou Google. Nenhum cartão de crédito necessário.</p>
            </div>
          </div>

          <div class="lp-step">
            <div class="lp-step__num">2</div>
            <div class="lp-step__content">
              <h3>Monte sua vitrine</h3>
              <p>Adicione foto, bio, especialidades e seus melhores projetos. O sistema é visual e intuitivo.</p>
            </div>
          </div>

          <div class="lp-step">
            <div class="lp-step__num">3</div>
            <div class="lp-step__content">
              <h3>Comece a receber propostas</h3>
              <p>Sua vitrine vai para o ar em v8pro.com.br/perfil/seunome — compartilhe no WhatsApp, LinkedIn e aguarde o Google indexar.</p>
            </div>
          </div>
        </div>

        <div class="steps-cta-row">
          <a href="/auth/register" class="lp-btn lp-btn--primary"
             data-cta-location="how_it_works" data-cta-label="Criar minha vitrine agora">Criar minha vitrine agora</a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         COMPARATIVO
    ════════════════════════════════════════════════════ -->
    <section class="lp-section lp-section--alt">
      <div class="lp-container">
        <h2 class="lp-section-title">Por que a vitrine bate o currículo</h2>
        <p class="lp-section-subtitle">Compare as formas mais comuns de divulgar seu trabalho.</p>

        <div class="lp-compare">
          <table>
            <thead>
              <tr>
                <th>Recurso</th>
                <th>VitrinePro</th>
                <th>LinkedIn</th>
                <th>Instagram</th>
                <th>Site próprio</th>
              </tr>
            </thead>
            <tbody>
              <tr class="lp-compare__highlight">
                <td>Portfólio visual com imagens</td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="partial">&#126;</span></td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="check">&#10003;</span></td>
              </tr>
              <tr>
                <td>URL permanente indexada no Google</td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="cross">&#10007;</span></td>
                <td><span class="check">&#10003;</span></td>
              </tr>
              <tr class="lp-compare__highlight">
                <td>Grátis para usar</td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="cross">&#10007;</span></td>
              </tr>
              <tr>
                <td>Botão WhatsApp / contato direto</td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="cross">&#10007;</span></td>
                <td><span class="partial">&#126;</span></td>
                <td><span class="check">&#10003;</span></td>
              </tr>
              <tr class="lp-compare__highlight">
                <td>Sem anúncios ou algoritmo</td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="cross">&#10007;</span></td>
                <td><span class="cross">&#10007;</span></td>
                <td><span class="check">&#10003;</span></td>
              </tr>
              <tr>
                <td>Configurado em menos de 5 min</td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="cross">&#10007;</span></td>
              </tr>
              <tr class="lp-compare__highlight">
                <td>Integração com vagas abertas</td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="check">&#10003;</span></td>
                <td><span class="cross">&#10007;</span></td>
                <td><span class="cross">&#10007;</span></td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         VAGAS EM DESTAQUE (MOCK)
    ════════════════════════════════════════════════════ -->
    <section class="lp-section">
      <div class="lp-container">
        <h2 class="lp-section-title">Vagas esperando por você</h2>
        <p class="lp-section-subtitle">Profissionais com vitrine no VitrinePro se candidatam com portfólio anexado — aumentando muito as chances de contratação.</p>

        <div class="lp-vagas-grid">
          <div class="lp-vaga-card">
            <div class="lp-vaga-card__top">
              <div>
                <h3 class="lp-vaga-card__title">Designer UI/UX Sênior</h3>
                <div class="lp-vaga-card__company">Agência Nova · Remoto</div>
              </div>
              <span class="lp-vaga-badge lp-vaga-badge--green">Nova</span>
            </div>
            <div class="lp-vaga-card__tags">
              <span class="lp-tag">Figma</span>
              <span class="lp-tag">Design System</span>
              <span class="lp-tag">Mobile</span>
            </div>
            <div class="lp-vaga-salary">R$6.000 – R$9.000/mês</div>
          </div>

          <div class="lp-vaga-card">
            <div class="lp-vaga-card__top">
              <div>
                <h3 class="lp-vaga-card__title">Fotógrafo de Produto</h3>
                <div class="lp-vaga-card__company">Marca Bela · São Paulo, SP</div>
              </div>
              <span class="lp-vaga-badge">Freelance</span>
            </div>
            <div class="lp-vaga-card__tags">
              <span class="lp-tag">Fotografia</span>
              <span class="lp-tag">Lightroom</span>
              <span class="lp-tag">E-commerce</span>
            </div>
            <div class="lp-vaga-salary">R$800 – R$1.500/projeto</div>
          </div>

          <div class="lp-vaga-card">
            <div class="lp-vaga-card__top">
              <div>
                <h3 class="lp-vaga-card__title">Advogado Trabalhista Jr</h3>
                <div class="lp-vaga-card__company">Escritório Mendes · Curitiba, PR</div>
              </div>
              <span class="lp-vaga-badge lp-vaga-badge--green">Nova</span>
            </div>
            <div class="lp-vaga-card__tags">
              <span class="lp-tag">Direito do Trabalho</span>
              <span class="lp-tag">OAB</span>
            </div>
            <div class="lp-vaga-salary">R$3.500 – R$5.000/mês</div>
          </div>

          <div class="lp-vaga-card">
            <div class="lp-vaga-card__top">
              <div>
                <h3 class="lp-vaga-card__title">Arquiteto de Interiores</h3>
                <div class="lp-vaga-card__company">Studio Forma · Belo Horizonte, MG</div>
              </div>
              <span class="lp-vaga-badge">CLT</span>
            </div>
            <div class="lp-vaga-card__tags">
              <span class="lp-tag">AutoCAD</span>
              <span class="lp-tag">Interiores</span>
              <span class="lp-tag">3D</span>
            </div>
            <div class="lp-vaga-salary">R$4.000 – R$6.500/mês</div>
          </div>

          <div class="lp-vaga-card">
            <div class="lp-vaga-card__top">
              <div>
                <h3 class="lp-vaga-card__title">Contador / Analista Fiscal</h3>
                <div class="lp-vaga-card__company">ContaFácil · Remoto</div>
              </div>
              <span class="lp-vaga-badge">Remoto</span>
            </div>
            <div class="lp-vaga-card__tags">
              <span class="lp-tag">Simples Nacional</span>
              <span class="lp-tag">IRPF</span>
              <span class="lp-tag">CRC</span>
            </div>
            <div class="lp-vaga-salary">R$3.000 – R$5.500/mês</div>
          </div>

          <div class="lp-vaga-card">
            <div class="lp-vaga-card__top">
              <div>
                <h3 class="lp-vaga-card__title">Consultor de Marketing Digital</h3>
                <div class="lp-vaga-card__company">StartUp XYZ · Remoto/SP</div>
              </div>
              <span class="lp-vaga-badge lp-vaga-badge--green">Urgente</span>
            </div>
            <div class="lp-vaga-card__tags">
              <span class="lp-tag">SEO</span>
              <span class="lp-tag">Tráfego Pago</span>
              <span class="lp-tag">Meta Ads</span>
            </div>
            <div class="lp-vaga-salary">R$5.000 – R$8.000/mês</div>
          </div>
        </div>

        <div class="steps-cta-row">
          <a href="/auth/register" class="lp-btn lp-btn--primary"
             data-cta-location="vagas" data-cta-label="Criar vitrine e se candidatar">Criar vitrine e se candidatar</a>
          <a href="/vagas" class="lp-btn lp-btn--text"
             data-cta-location="vagas" data-cta-label="Ver todas as vagas">Ver todas as vagas &rarr;</a>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         DEPOIMENTOS
    ════════════════════════════════════════════════════ -->
    <section class="lp-section lp-section--alt">
      <div class="lp-container">
        <h2 class="lp-section-title">O que dizem quem já tem sua vitrine</h2>
        <p class="lp-section-subtitle">Profissionais reais que pararam de mandar PDF e começaram a receber propostas.</p>

        <div class="lp-testimonials">
          <div class="lp-testimonial">
            <p class="lp-testimonial__quote">
              Em duas semanas minha vitrine apareceu no Google quando alguém pesquisou "fotógrafo de casamento em Florianópolis". Recebi 4 orçamentos sem postar nada nas redes.
            </p>
            <div class="lp-testimonial__author">
              <div class="lp-testimonial__avatar" style="background: #7c3aed;">RC</div>
              <div>
                <div class="lp-testimonial__name">Rafael Cardoso</div>
                <div class="lp-testimonial__role">Fotógrafo · Florianópolis, SC</div>
              </div>
            </div>
          </div>

          <div class="lp-testimonial">
            <p class="lp-testimonial__quote">
              Como advogada, nunca tive site porque parecia complicado e caro. Criei minha vitrine em 20 minutos. Agora clientes me acham no Google quando pesquisam minha área.
            </p>
            <div class="lp-testimonial__author">
              <div class="lp-testimonial__avatar" style="background: #2563eb;">ML</div>
              <div>
                <div class="lp-testimonial__name">Mariana Lopes</div>
                <div class="lp-testimonial__role">Advogada Trabalhista · Brasília, DF</div>
              </div>
            </div>
          </div>

          <div class="lp-testimonial">
            <p class="lp-testimonial__quote">
              Mandei o link da minha vitrine em vez do PDF do portfólio. O cliente ficou impressionado e fechou o projeto na mesma ligação. Nunca mais vou mandar PDF.
            </p>
            <div class="lp-testimonial__author">
              <div class="lp-testimonial__avatar" style="background: #10b981;">TP</div>
              <div>
                <div class="lp-testimonial__name">Thiago Pereira</div>
                <div class="lp-testimonial__role">Designer Gráfico · Recife, PE</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ═══════════════════════════════════════════════════
         PRICING
    ════════════════════════════════════════════════════ -->
    <section class="lp-section" id="pricing">
      <div class="lp-container">
        <h2 class="lp-section-title">Totalmente grátis</h2>
        <p class="lp-section-subtitle">Sem plano pago, sem cartão, sem pegadinha. Profissionais nunca pagam.</p>

        <div class="lp-pricing lp-pricing--single">

          <!-- Gratuito único -->
          <div class="lp-plan lp-plan--featured lp-plan--free-only">
            <div class="lp-plan__badge">Totalmente grátis</div>
            <div class="lp-plan__name">Grátis</div>
            <div class="lp-plan__desc">Tudo que você precisa para ser encontrado, mostrar seu trabalho e receber propostas — sem pagar nada.</div>
            <div class="lp-plan__price"><sup>R$</sup>0</div>
            <div class="lp-plan__period">Totalmente grátis · sem cartão de crédito</div>
            <ul class="lp-plan__features">
              <li>Vitrine online com URL personalizada</li>
              <li>Perfil público com foto, bio e contato</li>
              <li>Portfólio ilimitado de projetos</li>
              <li>Botão WhatsApp direto no perfil</li>
              <li>SEO completo (aparece no Google)</li>
              <li>Candidaturas a vagas abertas</li>
              <li>URL do tipo v8pro.com.br/perfil/seunome</li>
              <li>Destaque automático nas buscas</li>
              <li>Sem anúncios no seu perfil</li>
            </ul>
