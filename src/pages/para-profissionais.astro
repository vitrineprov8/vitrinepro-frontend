<script is:inline>
(function () {
  'use strict';

  var LP_NAME = 'para-profissionais';

  // Defensive: guarantee dataLayer exists even if GTM snippet hasn't run yet
  window.dataLayer = window.dataLayer || [];

  // ─── 1. page_view_lp ─────────────────────────────────────────────────────
  window.dataLayer.push({
    event: 'page_view_lp',
    lp_name: LP_NAME,
  });

  // ─── 2. cta_clicked (delegated) ──────────────────────────────────────────
  document.addEventListener('click', function (e) {
    var el = e.target && e.target.closest('[data-cta-location]');
    if (!el) return;

    var location = el.getAttribute('data-cta-location');
    var label    = el.getAttribute('data-cta-label') || '';
    var href     = el.getAttribute('href') || '';

    window.dataLayer.push({
      event: 'cta_clicked',
      lp_name: LP_NAME,
      cta_location: location,
      cta_label: label,
    });

    // signup_started: any CTA going to /auth/register (without hunter role)
    if (href.indexOf('/auth/register') !== -1 && href.indexOf('role=hunter') === -1) {
      window.dataLayer.push({
        event: 'signup_started',
        lp_name: LP_NAME,
        cta_location: location,
        cta_label: label,
      });
    }
  });

  // ─── 3. pricing_viewed (IntersectionObserver) ────────────────────────────
  var pricingSection = document.getElementById('pricing');
  if (pricingSection && typeof IntersectionObserver !== 'undefined') {
    var pricingObserver = new IntersectionObserver(function (entries) {
      entries.forEach(function (entry) {
        if (entry.isIntersecting) {
          window.dataLayer.push({
            event: 'pricing_viewed',
            lp_name: LP_NAME,
          });
          pricingObserver.disconnect();
        }
      });
    }, { threshold: 0.25 });
    pricingObserver.observe(pricingSection);
  }

  // ─── 4. faq_opened ───────────────────────────────────────────────────────
  var faqItems = document.querySelectorAll('.lp-faq-item');
  faqItems.forEach(function (details) {
    details.addEventListener('toggle', function () {
      if (details.open) {
        var summary = details.querySelector('summary');
        window.dataLayer.push({
          event: 'faq_opened',
          lp_name: LP_NAME,
          faq_question: summary ? summary.textContent.trim() : '',
        });
      }
    });
  });

  // ─── 5. scroll_depth (25 / 50 / 75 / 100%) ───────────────────────────────
  var scrollDepthFired = {};
  var scrollThresholds = [25, 50, 75, 100];

  function getScrollPercent() {
    var scrollTop  = window.pageYOffset || document.documentElement.scrollTop || 0;
    var docHeight  = Math.max(
      document.body.scrollHeight, document.documentElement.scrollHeight,
      document.body.offsetHeight, document.documentElement.offsetHeight
    ) - window.innerHeight;
    return docHeight > 0 ? Math.round((scrollTop / docHeight) * 100) : 0;
  }

  function onScroll() {
    var pct = getScrollPercent();
    scrollThresholds.forEach(function (threshold) {
      if (!scrollDepthFired[threshold] && pct >= threshold) {
        scrollDepthFired[threshold] = true;
        window.dataLayer.push({
          event: 'scroll_depth',
          lp_name: LP_NAME,
          scroll_depth_pct: threshold,
        });
      }
    });
  }

  window.addEventListener('scroll', onScroll, { passive: true });
})();
</script>

