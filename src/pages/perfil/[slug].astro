---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PublicProfilePage from '../../components/profile/PublicProfilePage.vue';

const SITE = 'https://v8pro.com.br';
const { slug: username } = Astro.params;
const BACKEND = import.meta.env.PUBLIC_BACKEND_URL || 'http://localhost:3000';

let profile: any = null;
let portfolioItems: any[] = [];
let cvList: any[] = [];
let education: any[] = [];
let notFound = false;

try {
  const profileRes = await fetch(`${BACKEND}/profile/${username}`);
  if (profileRes.status === 404) {
    notFound = true;
  } else if (profileRes.ok) {
    profile = await profileRes.json();

    const [portfolioRes, cvsRes, edusRes] = await Promise.allSettled([
      fetch(`${BACKEND}/portfolio?userId=${profile.id}&status=PUBLISHED&limit=20`).then(r => r.ok ? r.json() : { data: [] }),
      fetch(`${BACKEND}/cv/public/${profile.id}`).then(r => r.ok ? r.json() : []),
      fetch(`${BACKEND}/education/public/${profile.id}`).then(r => r.ok ? r.json() : []),
    ]);

    portfolioItems = portfolioRes.status === 'fulfilled' ? (portfolioRes.value?.data ?? []) : [];
    cvList         = cvsRes.status        === 'fulfilled' ? (cvsRes.value            ?? []) : [];
    education      = edusRes.status       === 'fulfilled' ? (edusRes.value           ?? []) : [];
  } else {
    notFound = true;
  }
} catch {
  notFound = true;
}

if (notFound) {
  try {
    const tombRes = await fetch(`${BACKEND}/seo/tombstone?type=profile&slug=${encodeURIComponent(username ?? '')}`);
    if (tombRes.ok) {
      const tomb = await tombRes.json();
      if (tomb?.exists && tomb.reason === 'renamed' && tomb.redirectTo) {
        return Astro.redirect(tomb.redirectTo, 301);
      }
      Astro.response.status = tomb?.exists ? 410 : 404;
    } else {
      Astro.response.status = 404;
    }
  } catch {
    Astro.response.status = 404;
  }
  Astro.response.headers.set('Cache-Control', 'public, max-age=300');
}

const hasBio = !!(profile?.bio && profile.bio.trim().length > 0);
const hasPublishedItems = portfolioItems.length > 0;
const isThinProfile = !!profile && !hasBio && !hasPublishedItems;
const isHidden = !!profile && profile.isVisible === false;
const shouldNoindex = notFound || isThinProfile || isHidden;

const fullName = profile ? `${profile.firstName ?? ''} ${profile.lastName ?? ''}`.trim() : '';
const title = profile
  ? `${fullName}${profile.profession ? ' - ' + profile.profession : ''} | VitrinePro`
  : 'Perfil não encontrado | VitrinePro';
const description = profile?.bio || `Portfólio profissional de ${fullName} no VitrinePro`;
const ogImage = profile?.avatarUrl || `${SITE}/og-default.png`;
const canonicalUrl = `${SITE}/perfil/${username}`;

const socialPrefixes: Record<string, string> = {
  linkedin: 'https://linkedin.com/in/', github: 'https://github.com/',
  twitter: 'https://x.com/', instagram: 'https://instagram.com/',
  facebook: 'https://facebook.com/', youtube: 'https://youtube.com/@', tiktok: 'https://tiktok.com/@',
};
const sameAs = profile?.socialLinks
  ? Object.entries(profile.socialLinks)
      .filter(([, v]) => !!v)
      .map(([k, v]) => (v as string).startsWith('http') ? v as string : `${socialPrefixes[k] ?? ''}${v}`)
  : [];

const personSchema = profile ? {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: fullName,
  ...(profile.profession ? { jobTitle: profile.profession } : {}),
  ...(profile.bio ? { description: profile.bio } : {}),
  image: profile.avatarUrl || undefined,
  url: canonicalUrl,
  ...(profile.website ? { sameAs: [profile.website, ...sameAs] } : (sameAs.length ? { sameAs } : {})),
  ...(profile.location ? { address: { '@type': 'PostalAddress', addressLocality: profile.location } } : {}),
} : null;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogType="profile"
  noindex={shouldNoindex}
>
  <Fragment slot="head">
    {profile?.firstName && <meta property="profile:first_name" content={profile.firstName} />}
    {profile?.lastName && <meta property="profile:last_name" content={profile.lastName} />}
    {username && <meta property="profile:username" content={username} />}
    {personSchema && <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />}
  </Fragment>

  <Header />
  <main>
    {notFound ? (
      <div style="min-height:60vh;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;text-align:center;padding:2rem">
        <h1 style="font-size:1.5rem;color:var(--text-primary)">Perfil não encontrado</h1>
        <p style="color:var(--text-secondary)">O usuário <strong>{username}</strong> não existe ou o perfil está privado.</p>
        <a href="/" class="btn btn-primary">Voltar ao início</a>
      </div>
    ) : (
      <PublicProfilePage
        client:load
        profile={profile}
        portfolioItems={portfolioItems}
        cvList={cvList}
        education={education}
      />
    )}
  </main>
  <Footer />

  <style is:global>
    @import '../../styles/dashboard.css';
  </style>
</BaseLayout>
