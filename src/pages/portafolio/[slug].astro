---
export const prerender = false;
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PortfolioContent from '../../components/profile/PortfolioContent.vue';

const SITE = 'https://v8pro.com.br';
const { slug } = Astro.params;
const BACKEND = import.meta.env.PUBLIC_BACKEND_URL || 'http://localhost:3000';

let item: any = null;
let notFound = false;

try {
  const res = await fetch(`${BACKEND}/portfolio/${slug}`);
  if (res.status === 404) {
    notFound = true;
  } else if (res.ok) {
    item = await res.json();
  } else {
    notFound = true;
  }
} catch {
  notFound = true;
}

const authorName = item?.user
  ? `${item.user.firstName ?? ''} ${item.user.lastName ?? ''}`.trim()
  : 'VitrinePro';
const authorUsername = item?.user?.username ?? null;

const title = item ? `${item.title} | VitrinePro` : 'Item não encontrado | VitrinePro';
const description = item?.subtitle || item?.description || 'Veja este item no VitrinePro';
const ogImage = item?.coverImageUrl || `${SITE}/og-default.png`;
const canonicalUrl = `${SITE}/portafolio/${slug}`;

const allImages = [
  ...(item?.coverImageUrl ? [item.coverImageUrl] : []),
  ...(item?.files ?? []).filter((f: any) => f.fileType === 'IMAGE').map((f: any) => f.fileUrl),
].slice(0, 5);

const itemSchema = item ? {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: item.title,
  description: item.subtitle || item.description,
  image: allImages,
  url: canonicalUrl,
  dateCreated: item.createdAt,
  dateModified: item.updatedAt,
  creator: {
    '@type': 'Person',
    name: authorName,
    url: authorUsername ? `${SITE}/perfil/${authorUsername}` : SITE,
  },
  ...(item.tags?.length ? { keywords: item.tags.map((t: any) => t.name).join(', ') } : {}),
  ...(item.externalUrl ? { sameAs: item.externalUrl } : {}),
} : null;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {item && <meta name="author" content={authorName} />}
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="VitrinePro" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@vitrinev8pro" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {itemSchema && <script type="application/ld+json" set:html={JSON.stringify(itemSchema)} />}

    <style is:global>
      @import '../../styles/global.css';
      @import '../../styles/dashboard.css';
    </style>
  </head>
  <body>
    <Header />
    <main>
      {notFound ? (
        <div style="min-height:60vh;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;text-align:center;padding:2rem">
          <h1 style="font-size:1.5rem;color:var(--text-primary)">Item não encontrado</h1>
          <p style="color:var(--text-secondary)">Este item não existe ou foi removido.</p>
          <a href="/" class="btn btn-primary">Voltar ao início</a>
        </div>
      ) : (
        <PortfolioContent client:load item={item} />
      )}
    </main>
    <Footer />
  </body>
</html>
