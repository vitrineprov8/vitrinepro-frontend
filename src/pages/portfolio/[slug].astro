---
export const prerender = false;
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import PortfolioContent from '../../components/profile/PortfolioContent.vue';

const SITE = 'https://v8pro.com.br';
const { slug } = Astro.params;
const BACKEND = import.meta.env.PUBLIC_BACKEND_URL || 'http://localhost:3000';

let item: any = null;
let notFound = false;

try {
  const res = await fetch(`${BACKEND}/portfolio/${slug}`);
  if (res.status === 404) {
    notFound = true;
  } else if (res.ok) {
    item = await res.json();
  } else {
    notFound = true;
  }
} catch {
  notFound = true;
}

if (notFound) {
  try {
    const tombRes = await fetch(`${BACKEND}/seo/tombstone?type=portfolio&slug=${encodeURIComponent(slug ?? '')}`);
    if (tombRes.ok) {
      const tomb = await tombRes.json();
      if (tomb?.exists && tomb.reason === 'renamed' && tomb.redirectTo) {
        return Astro.redirect(tomb.redirectTo, 301);
      }
      Astro.response.status = tomb?.exists ? 410 : 404;
    } else {
      Astro.response.status = 404;
    }
  } catch {
    Astro.response.status = 404;
  }
  Astro.response.headers.set('Cache-Control', 'public, max-age=300');
}

const isDraft = !!item && item.status === 'DRAFT';
const shouldNoindex = notFound || isDraft;

const authorName = item?.user
  ? `${item.user.firstName ?? ''} ${item.user.lastName ?? ''}`.trim()
  : 'VitrinePro';
const authorUsername = item?.user?.username ?? null;

const title = item ? `${item.title} | VitrinePro` : 'Item não encontrado | VitrinePro';
const description = item?.subtitle || item?.description || 'Veja este item no VitrinePro';
const ogImage = item?.coverImageUrl || `${SITE}/og-default.png`;
const canonicalUrl = `${SITE}/portfolio/${slug}`;

const allImages = [
  ...(item?.coverImageUrl ? [item.coverImageUrl] : []),
  ...(item?.files ?? []).filter((f: any) => f.fileType === 'IMAGE').map((f: any) => f.fileUrl),
].slice(0, 5);

const itemSchema = item ? {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: item.title,
  description: item.subtitle || item.description,
  image: allImages,
  url: canonicalUrl,
  dateCreated: item.createdAt,
  dateModified: item.updatedAt,
  creator: {
    '@type': 'Person',
    name: authorName,
    url: authorUsername ? `${SITE}/perfil/${authorUsername}` : SITE,
  },
  ...(item.tags?.length ? { keywords: item.tags.map((t: any) => t.name).join(', ') } : {}),
  ...(item.externalUrl ? { sameAs: item.externalUrl } : {}),
} : null;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage={ogImage}
  ogType="website"
  noindex={shouldNoindex}
>
  <Fragment slot="head">
    {item && <meta name="author" content={authorName} />}
    {itemSchema && <script type="application/ld+json" set:html={JSON.stringify(itemSchema)} />}
  </Fragment>

  <Header />
  <main>
    <div>
    {notFound ? (
      <div style="min-height:60vh;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;text-align:center;padding:2rem">
        <h1 style="font-size:1.5rem;color:var(--text-primary)">Item não encontrado</h1>
        <p style="color:var(--text-secondary)">Este item não existe ou foi removido.</p>
        <a href="/" class="btn btn-primary">Voltar ao início</a>
      </div>
    ) : (
      <PortfolioContent client:load item={item} />
    )}
    </div>
  </main>
  <Footer />

  <style is:global>
    @import '../../styles/dashboard.css';
  </style>
</BaseLayout>
