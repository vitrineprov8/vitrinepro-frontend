---
export const prerender = false;
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import ProjectContent from '../../components/profile/ProjectContent.vue';

const SITE = 'https://v8pro.com.br';
const { slug } = Astro.params;
const BACKEND = import.meta.env.PUBLIC_BACKEND_URL || 'http://localhost:3000';

let project: any = null;
let notFound = false;

try {
  const res = await fetch(`${BACKEND}/projects/${slug}`);
  if (res.status === 404) {
    notFound = true;
  } else if (res.ok) {
    project = await res.json();
  } else {
    notFound = true;
  }
} catch {
  notFound = true;
}

const authorName = project?.user
  ? `${project.user.firstName ?? ''} ${project.user.lastName ?? ''}`.trim()
  : 'VitrinePro';
const authorUsername = project?.user?.username ?? null;

const title = project ? `${project.title} | VitrinePro` : 'Projeto não encontrado | VitrinePro';
const description = project?.subtitle || project?.description || 'Veja este projeto no VitrinePro';
const ogImage = project?.coverImageUrl || `${SITE}/og-default.png`;
const canonicalUrl = `${SITE}/projeto/${slug}`;

// All project images for schema
const allImages = [
  ...(project?.coverImageUrl ? [project.coverImageUrl] : []),
  ...(project?.images ?? []).map((i: any) => i.imageUrl),
].slice(0, 5);

// JSON-LD CreativeWork
const projectSchema = project ? {
  '@context': 'https://schema.org',
  '@type': 'CreativeWork',
  name: project.title,
  description: project.subtitle || project.description,
  image: allImages,
  url: canonicalUrl,
  dateCreated: project.createdAt,
  dateModified: project.updatedAt,
  creator: {
    '@type': 'Person',
    name: authorName,
    url: authorUsername ? `${SITE}/perfil/${authorUsername}` : SITE,
  },
  ...(project.tags?.length ? { keywords: project.tags.map((t: any) => t.name).join(', ') } : {}),
  ...(project.externalUrl ? { sameAs: project.externalUrl } : {}),
} : null;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {project && <meta name="author" content={authorName} />}
    <link rel="canonical" href={canonicalUrl} />

    <!-- Open Graph -->
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="VitrinePro" />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@vitrinev8pro" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- JSON-LD CreativeWork -->
    {projectSchema && <script type="application/ld+json" set:html={JSON.stringify(projectSchema)} />}

    <style is:global>
      @import '../../styles/global.css';
      @import '../../styles/dashboard.css';
    </style>
  </head>
  <body>
    <Header />
    <main>
      {notFound ? (
        <div style="min-height:60vh;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:1rem;text-align:center;padding:2rem">
          <h1 style="font-size:1.5rem;color:var(--text-primary)">Projeto não encontrado</h1>
          <p style="color:var(--text-secondary)">Este projeto não existe ou foi removido.</p>
          <a href="/" class="btn btn-primary">Voltar ao início</a>
        </div>
      ) : (
        <ProjectContent client:load project={project} />
      )}
    </main>
    <Footer />
  </body>
</html>
