---
export const prerender = false;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SearchPage from '../components/search/SearchPage.vue';
import ClarityScript from '../components/ClarityScript.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

const SITE = 'https://v8pro.com.br';
const title = 'Vitrine | VitrinePro';
const description = 'Encontre profissionais, projetos e serviços no VitrinePro.';
const canonicalUrl = `${SITE}/vitrine`;
---

<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={`${SITE}/og-default.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="VitrinePro" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@vitrinev8pro" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${SITE}/og-default.png`} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <style is:global>
      @import '../styles/global.css';
      @import '../styles/dashboard.css';
      @import '../styles/search.css';
    </style>
    <GoogleAnalytics measurementId={'G-G5CL10932J'} />
    <ClarityScript />
  </head>
  <body>
    <Header />
    <main>
      <SearchPage client:load />
    </main>
    <Footer />
  </body>
</html>
